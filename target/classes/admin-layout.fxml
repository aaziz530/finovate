<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@styles/antigravity.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.esprit.finovate.controllers.AdminLayoutController">
    <!-- Base Layout -->
    <BorderPane fx:id="mainContainer" prefWidth="1200.0" prefHeight="750.0">
        
        <!-- SIDEBAR -->
        <left>
            <VBox styleClass="sidebar" prefWidth="260" spacing="10" 
                  style="-fx-padding: 20 0 20 0;">
                
                <!-- Logo & Brand -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 20 20 20;">
                    <Label text="🚀" style="-fx-font-size: 24px; -fx-text-fill: #3b82f6;" />
                    <VBox>
                        <Label text="ANTIGRAVITY" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #F8FAFC; -fx-letter-spacing: 2px;" />
                        <Label text="Admin Dashboard" style="-fx-font-size: 11px; -fx-text-fill: #8B5CF6;" />
                    </VBox>
                </HBox>
                
                <!-- User Profile Snippet (Optional but nice) -->
                <VBox alignment="CENTER" spacing="8" style="-fx-padding: 0 20 20 20; -fx-border-color: transparent transparent #334155 transparent; -fx-border-width: 0 0 1 0;">
                    <Circle radius="30" fill="#3b82f6" style="-fx-opacity: 0.2;"/>
                    <Label fx:id="lblWelcome" text="Welcome, Admin" style="-fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                    <Button text="⏻ Logout" onAction="#onLogout" 
                            style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-border-color: #ef4444; -fx-border-radius: 4; -fx-padding: 4 12; -fx-cursor: hand; -fx-font-size: 11px;" />
                </VBox>

                <!-- Navigation -->
                <VBox spacing="5" style="-fx-padding: 15 0 0 0;">
                    <Label text="NAVIGATION" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 0 5 20;" />
                    
                    <Button fx:id="menuDashboard" text="📊 Dashboard" styleClass="sidebar-button, sidebar-button-active" maxWidth="Infinity" onAction="#showDashboard"/>
                    <Button fx:id="menuTickets" text="🎫 Gestion Tickets" styleClass="sidebar-button" maxWidth="Infinity" onAction="#showTickets"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <!-- Quick Actions Panel -->
                <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #1e293b; -fx-border-color: #334155 transparent transparent transparent; -fx-border-width: 1 0 0 0;">
                    <Label text="ACTIONS RAPIDES" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;" />
                    
                    <Button fx:id="btnQuickAdd" text="➕ Ajouter" styleClass="btn-add" maxWidth="Infinity" onAction="#onAddTicket"/>
                    <Button fx:id="btnQuickEdit" text="✏️ Modifier" styleClass="btn-edit" maxWidth="Infinity" onAction="#onEditTicket" disable="true"/>
                    <Button fx:id="btnQuickDelete" text="🗑️ Supprimer" styleClass="btn-delete" maxWidth="Infinity" onAction="#onDeleteTicket" disable="true"/>
                </VBox>
                
            </VBox>
        </left>

        <!-- CENTER CONTENT AREA -->
        <center>
            <StackPane fx:id="contentArea" style="-fx-background-color: #0F172A;">
                
                <!-- VIEW 1: DASHBOARD -->
                <ScrollPane fx:id="viewDashboard" fitToWidth="true" style="-fx-background: #0F172A; -fx-background-color: #0F172A; -fx-border-color: transparent;">
                    <VBox spacing="24">
                        <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

                        <VBox spacing="4">
                            <Label text="Tableau de bord" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                            <Label text="Vue d'ensemble en temps réel" style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;"/>
                        </VBox>

                        <!-- STAT CARDS -->
                        <HBox spacing="16">
                            <VBox spacing="8" prefWidth="200" styleClass="stat-card, stat-card-total">
                                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                                <Label text="👥 Total Utilisateurs" style="-fx-font-size: 13px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                                <Label fx:id="lblTotalUsers" text="0" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                                <Label text="Comptes enregistrés" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                            </VBox>
                            <VBox spacing="8" prefWidth="200" styleClass="stat-card, stat-card-open">
                                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                                <Label text="📋 Tickets ouverts" style="-fx-font-size: 13px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                                <Label fx:id="lblOpenTickets" text="0" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #8b5cf6;"/>
                                <Label text="Nouveaux tickets" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                            </VBox>
                            <VBox spacing="8" prefWidth="200" styleClass="stat-card, stat-card-progress">
                                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                                <Label text="⏳ En cours" style="-fx-font-size: 13px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                                <Label fx:id="lblInProgressTickets" text="0" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                                <Label text="En traitement" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                            </VBox>
                            <VBox spacing="8" prefWidth="200" styleClass="stat-card, stat-card-resolved">
                                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                                <Label text="✅ Résolus" style="-fx-font-size: 13px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                                <Label fx:id="lblResolvedTickets" text="0" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                                <Label text="Clôturés avec succès" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                            </VBox>
                            <VBox spacing="8" prefWidth="200" styleClass="stat-card, stat-card-high">
                                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                                <Label text="🔴 Priorité haute" style="-fx-font-size: 13px; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
                                <Label fx:id="lblHighPriorityTickets" text="0" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #ef4444;"/>
                                <Label text="Urgents" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                            </VBox>
                        </HBox>

                        <!-- CHARTS -->
                        <HBox spacing="16">
                            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="stat-card" style="-fx-padding: 20;">
                                <Label text="Répartition par statut" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                                <Label text="Nombre de tickets par catégorie" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;"/>
                                <BarChart fx:id="ticketsByStatusChart" prefHeight="260" animated="true" styleClass="chart">
                                    <xAxis><CategoryAxis styleClass="axis"/></xAxis>
                                    <yAxis><NumberAxis styleClass="axis"/></yAxis>
                                </BarChart>
                            </VBox>
                            <VBox spacing="8" prefWidth="350" styleClass="stat-card" style="-fx-padding: 20;">
                                <Label text="Ouverts vs Fermés" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                                <Label text="Distribution globale" style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;"/>
                                <PieChart fx:id="openVsClosedChart" prefHeight="260" animated="true" style="-fx-background-color: transparent;"/>
                            </VBox>
                        </HBox>

                    </VBox>
                </ScrollPane>

                <!-- VIEW 2: GESTION TICKETS -->
                <VBox fx:id="viewTickets" spacing="20" visible="false" managed="false" style="-fx-background-color: #0F172A;">
                    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Gestion des Tickets" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                            <Label text="Consulter, modifier et supprimer les tickets" style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnAddTicket" text="➕ Nouveau Ticket" onAction="#onAddTicket" styleClass="btn-add" style="-fx-padding: 10 20; -fx-font-weight: bold;" />
                    </HBox>
                    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="stat-card" style="-fx-padding: 16;">
                        <TableView fx:id="latestTicketsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colLatestType" text="Type" prefWidth="150"/>
                                <TableColumn fx:id="colLatestPriorite" text="Priorité" prefWidth="120"/>
                                <TableColumn fx:id="colLatestStatut" text="Statut" prefWidth="120"/>
                                <TableColumn fx:id="colLatestDate" text="Date Création" prefWidth="160"/>
                                <TableColumn fx:id="colLatestDescription" text="Description" prefWidth="250"/>
                                <TableColumn fx:id="colLatestActions" text="Actions" prefWidth="200"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>

                <!-- VIEW 3: AGENTS -->
                <VBox fx:id="viewAgents" spacing="20" visible="false" managed="false" style="-fx-background-color: #0F172A;">
                    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
                    <VBox spacing="4">
                        <Label text="Gestion des Agents" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                        <Label text="Performance et suivi des agents de support" style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;"/>
                    </VBox>
                    <VBox VBox.vgrow="ALWAYS" styleClass="stat-card" style="-fx-padding: 16;">
                        <TableView fx:id="agentsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colAgentNom" text="Agent" prefWidth="200"/>
                                <TableColumn fx:id="colTicketsAssignes" text="Tickets assignés" prefWidth="150"/>
                                <TableColumn fx:id="colTicketsOuverts" text="Ouverts" prefWidth="120"/>
                                <TableColumn fx:id="colTicketsResolus" text="Résolus" prefWidth="120"/>
                                <TableColumn fx:id="colPerformance" text="Performance" prefWidth="200"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>

            </StackPane>
        </center>
    </BorderPane>

    <!-- OVERLAY LAYERS -->

    <!-- MODAL 1: ADD TICKET -->
    <StackPane fx:id="modalAddTicket" styleClass="modal-overlay" visible="false" managed="false">
        <VBox styleClass="modal-content" maxWidth="500" maxHeight="450" spacing="20">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
            <Label text="➕ Créer un nouveau Ticket" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
            
            <VBox spacing="5">
                <Label text="Type de ticket" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                <ComboBox fx:id="cmbAddType" maxWidth="Infinity" styleClass="combo-box"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Priorité" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                <ComboBox fx:id="cmbAddPriority" maxWidth="Infinity" styleClass="combo-box"/>
            </VBox>
            
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Label text="Description du problème" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                <TextArea fx:id="txtAddDescription" wrapText="true" VBox.vgrow="ALWAYS" styleClass="text-field" style="-fx-pref-row-count: 4;"/>
            </VBox>

            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                <Button text="Annuler" onAction="#closeModals" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-cursor: hand; -fx-padding: 8 16;"/>
                <Button text="Enregistrer" onAction="#saveNewTicket" styleClass="btn-add" style="-fx-font-weight: bold; -fx-padding: 8 20;"/>
            </HBox>
        </VBox>
    </StackPane>

    <!-- MODAL 2: EDIT TICKET -->
    <StackPane fx:id="modalEditTicket" styleClass="modal-overlay" visible="false" managed="false">
        <VBox styleClass="modal-content" maxWidth="500" maxHeight="500" spacing="20">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
            <Label text="✏️ Modifier le Ticket" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
            
            <VBox spacing="5">
                <Label text="Statut" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                <ComboBox fx:id="cmbEditStatus" maxWidth="Infinity" styleClass="combo-box"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Type" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                <ComboBox fx:id="cmbEditType" maxWidth="Infinity" styleClass="combo-box"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Priorité" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                <ComboBox fx:id="cmbEditPriority" maxWidth="Infinity" styleClass="combo-box"/>
            </VBox>
            
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Label text="Description" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                <TextArea fx:id="txtEditDescription" wrapText="true" VBox.vgrow="ALWAYS" styleClass="text-field" style="-fx-pref-row-count: 4;"/>
            </VBox>

            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                <Button text="Annuler" onAction="#closeModals" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-cursor: hand; -fx-padding: 8 16;"/>
                <Button text="Mettre à jour" onAction="#updateTicket" styleClass="btn-edit" style="-fx-font-weight: bold; -fx-padding: 8 20;"/>
            </HBox>
        </VBox>
    </StackPane>

    <!-- MODAL 3: DELETE CONFIRMATION -->
    <StackPane fx:id="modalDeleteTicket" styleClass="modal-overlay" visible="false" managed="false">
        <VBox styleClass="modal-content" maxWidth="400" maxHeight="200" spacing="15" alignment="CENTER">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
            
            <Label text="⚠️" style="-fx-font-size: 40px;"/>
            <Label text="Supprimer ce ticket ?" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
            <Label text="Cette action est irréversible. Toutes les données liées seront perdues." wrapText="true" style="-fx-text-fill: #94A3B8; -fx-text-alignment: center; -fx-font-size: 13px;"/>

            <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                <Button text="Annuler" onAction="#closeModals" style="-fx-background-color: #334155; -fx-text-fill: #F8FAFC; -fx-padding: 8 20; -fx-cursor: hand; -fx-background-radius: 6;"/>
                <Button text="Supprimer définitivement" onAction="#confirmDeleteTicket" styleClass="btn-delete" style="-fx-font-weight: bold; -fx-padding: 8 20; -fx-background-color: #ef4444; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </StackPane>

    <!-- TOAST NOTIFICATION CONTAINER -->
    <VBox fx:id="toastContainer" mouseTransparent="true" spacing="10" 
          AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20"
          StackPane.alignment="BOTTOM_RIGHT"
          style="-fx-padding: 20;">
        <!-- Toasts will be dynamically added here by controller -->
    </VBox>

</StackPane>