<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.esprit.finovate.controllers.TicketDetailController"
            prefWidth="900.0" prefHeight="600.0">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Infos ticket gauche -->
    <left>
        <VBox spacing="8.0" prefWidth="260.0"
              style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 8, 0.3, 0, 3);">
            <Label text="Infos ticket"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

            <Label text="Titre" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
            <TextField fx:id="titreField"/>

            <Label text="Description" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
            <TextArea fx:id="descriptionArea" prefRowCount="4" wrapText="true"/>

            <Label text="Client" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
            <TextField fx:id="clientField"/>

            <Label text="Catégorie" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
            <ComboBox fx:id="categorieCombo"/>

            <Label text="Priorité" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
            <ComboBox fx:id="prioriteCombo"/>

            <Label text="Statut" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
            <ComboBox fx:id="statutCombo"/>

            <Label text="Assigné à" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
            <ComboBox fx:id="agentCombo"/>

            <Button text="Enregistrer les changements" onAction="#onSaveChanges"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-margin-top: 8;"/>
        </VBox>
    </left>

    <!-- Conversation centre -->
    <center>
        <VBox spacing="8.0">
            <Label text="Conversation"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

            <ListView fx:id="conversationList" VBox.vgrow="ALWAYS"/>

            <VBox spacing="4.0"
                  style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 8, 0.3, 0, 3);">
                <Label text="Réponse"
                       style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                <TextArea fx:id="reponseArea" prefRowCount="3"/>
                <HBox spacing="8.0">
                    <Button text="Joindre un fichier" onAction="#onAttachFile"
                            style="-fx-background-color: #e5e7eb; -fx-text-fill: #111827;"/>
                    <Button text="Envoyer la réponse" onAction="#onSendReply"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- Historique droite -->
    <right>
        <VBox spacing="8.0" prefWidth="260.0"
              style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 8, 0.3, 0, 3);">
            <Label text="Historique"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

            <TableView fx:id="historyTable" prefHeight="400.0">
                <columns>
                    <TableColumn fx:id="colHistoryDate" text="Date" prefWidth="120.0"/>
                    <TableColumn fx:id="colHistoryAction" text="Action" prefWidth="140.0"/>
                </columns>
            </TableView>
        </VBox>
    </right>

</BorderPane>

