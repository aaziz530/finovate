<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.esprit.finovate.controllers.CreatePostPageController"
      spacing="0"
      style="-fx-background-color: #F5F5F5;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: linear-gradient(to right, #237f4e, #2d9960); -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(35,127,78,0.3), 10, 0, 0, 4);">
        <Button fx:id="backBtn" text="←" onAction="#handleBack"
                style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Label text="📝" style="-fx-font-size: 32px;"/>
        <Label text="Créer un Nouveau Post" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </HBox>

    <!-- Content -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="25" style="-fx-padding: 40;">
            
            <!-- Form Card -->
            <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3);">
                
                <!-- Title Field -->
                <VBox spacing="8">
                    <Label text="Titre du Post *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #237f4e;"/>
                    <TextField fx:id="titleField" promptText="Ex: Comment investir dans la blockchain?" 
                               style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #237f4e; -fx-border-width: 2; -fx-border-radius: 8;"/>
                    <Label fx:id="titleError" style="-fx-text-fill: #D32F2F; -fx-font-size: 12px;" visible="false" managed="false"/>
                </VBox>

                <!-- Content Field -->
                <VBox spacing="8">
                    <Label text="Contenu *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                    <TextArea fx:id="contentField" promptText="Partagez vos idées, questions ou expériences..." 
                              wrapText="true" prefRowCount="8"
                              style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #237f4e; -fx-border-width: 2; -fx-border-radius: 8;"/>
                    <Label fx:id="contentError" style="-fx-text-fill: #D32F2F; -fx-font-size: 12px;" visible="false" managed="false"/>
                </VBox>

                <!-- Info Box -->
                <HBox spacing="10" style="-fx-background-color: #E8F5E9; -fx-padding: 15; -fx-background-radius: 8;">
                    <Label text="💡" style="-fx-font-size: 20px;"/>
                    <Label text="Un bon post a un titre accrocheur et un contenu détaillé qui apporte de la valeur à la communauté." 
                           wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #2E7D32;" HBox.hgrow="ALWAYS"/>
                </HBox>

            </VBox>

            <!-- Buttons -->
            <HBox spacing="15" alignment="CENTER">
                <Button fx:id="cancelBtn" text="Annuler" onAction="#handleCancel"
                        style="-fx-background-color: #E0E0E0; -fx-text-fill: #666; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 40; -fx-background-radius: 10; -fx-cursor: hand;"/>
                <Button fx:id="createBtn" text="Publier le Post" onAction="#handleCreate"
                        style="-fx-background-color: #237f4e; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 40; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(35,127,78,0.3), 10, 0, 0, 4);"/>
            </HBox>

        </VBox>
    </ScrollPane>

</VBox>
