<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.esprit.finovate.controllers.DashboardController"
      spacing="20"
      alignment="TOP_LEFT"
      styleClass="root"
      stylesheets="@../css/style.css">

    <VBox alignment="TOP_LEFT" spacing="20" styleClass="dashboard-content">
        <Label text="All Projects" styleClass="section-title"/>
        <HBox styleClass="toolbar-card" spacing="16" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearchDynamic" promptText="Recherche dynamique..." prefWidth="240"/>
            <ComboBox fx:id="comboStatus" promptText="Statut" prefWidth="130"/>
            <Button text="Rechercher" onAction="#handleStaticSearch" styleClass="btn-primary"/>
            <ComboBox fx:id="comboTri" promptText="Trier par" prefWidth="150"/>
        </HBox>
        <ScrollPane fitToWidth="true" styleClass="projects-scroll" VBox.vgrow="ALWAYS">
            <VBox fx:id="projectsContainer" spacing="12"/>
        </ScrollPane>
    </VBox>

</VBox>
