<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.ComboBox?>
<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.esprit.finovate.controllers.MarketplaceController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #BBDB90;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Label text="Marketplace &amp; Rewards" textFill="#366767">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Mon Solde : " textFill="#366767">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblSoldePoints" text="0 pts" textFill="#366767">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="15.0" right="20.0" left="20.0" bottom="5.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <TextField fx:id="txtRecherche" promptText="Rechercher un produit..." prefWidth="300.0" style="-fx-background-radius: 20; -fx-padding: 8 15;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Trier par :" textFill="#366767">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <ComboBox fx:id="comboTri" prefWidth="180.0" style="-fx-background-radius: 20;" />
            </HBox>

            <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <GridPane fx:id="gridProduits" hgap="20.0" vgap="20.0">
                        <padding>
                            <Insets bottom="20.0" left="5.0" right="5.0" top="5.0" />
                        </padding>
                    </GridPane>
                </content>
            </ScrollPane>
        </VBox>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" prefWidth="250.0" spacing="15.0" style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 0 0 0 1;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <children>
                <Label text="Gagnez des points !" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Label text="Regardez une courte publicité pour gagner des points instantanément." textAlignment="CENTER" wrapText="true" textFill="#7f8c8d" />

                <Button mnemonicParsing="false" onAction="#onWatchAd" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #366767; -fx-text-fill: white; -fx-cursor: hand;" text="Regarder Pub (+pts)">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </right>
</BorderPane>
