<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="500.0" prefWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.esprit.finovate.controllers.AdsAdminController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <VBox prefWidth="300.0" spacing="10.0" style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-background-radius: 10;">
        <Label text="Gestion Publicités" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label text="Titre de la pub" />
        <TextField fx:id="txtTitre" promptText="Ex: Promo Nike" />

        <Label text="Chemin Image" />
        <HBox spacing="5">
            <TextField fx:id="txtImage" promptText="/images/pub.png" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#choisirImage" text="Parcourir..." />
        </HBox>

        <Label text="Durée (secondes)" />
        <TextField fx:id="txtDuree" promptText="5" />

        <Label text="Points gagnés" />
        <TextField fx:id="txtPoints" promptText="10" />

        <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 20 0 0 0;">
            <Button mnemonicParsing="false" onAction="#ajouter" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Ajouter" />
            <Button mnemonicParsing="false" onAction="#modifier" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="Modifier" />
            <Button mnemonicParsing="false" onAction="#supprimer" style="-fx-background-color: #c0392b; -fx-text-fill: white;" text="Supprimer" />
        </HBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS">
        <Label text="Liste des publicités actives" />
        <TextField fx:id="txtRechercheAds" promptText="Rechercher une publicité..." />
        <TableView fx:id="tableAds" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTitre" prefWidth="150.0" text="Titre" />
                <TableColumn fx:id="colDuree" prefWidth="75.0" text="Durée (s)" />
                <TableColumn fx:id="colPoints" prefWidth="75.0" text="Points" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</HBox>
