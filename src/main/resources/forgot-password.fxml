<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.esprit.finovate.controllers.ForgotPasswordController"
      alignment="CENTER" spacing="20"
      style="-fx-background-color: #f0f8f0; -fx-padding: 48;">

    <VBox alignment="CENTER" spacing="16"
          style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 12, 0, 0, 4); -fx-padding: 40;">
        <padding><Insets top="32" right="40" bottom="32" left="40"/></padding>

        <Label text="FINOVATE"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2e8b57;"/>

        <Label text="Forgot Password?"
               style="-fx-font-size: 18px; -fx-text-fill: #2D3748;"/>

        <Label text="Enter your email to receive a reset code"
               style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>

        <Label text="Email Address"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2D3748;"/>
        <TextField fx:id="fieldEmail" promptText="your@email.com"
                   style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-background-radius: 6; -fx-padding: 10 14; -fx-prefWidth: 280;"/>

        <Button text="Send Reset Code" onAction="#onSendResetCode"
                style="-fx-background-color: #2e8b57; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 12 24; -fx-cursor: hand;"/>

        <HBox alignment="CENTER" spacing="4">
            <Label text="Remembered your password? " style="-fx-text-fill: #718096; -fx-font-size: 12px;"/>
            <Button fx:id="linkBackToLogin" text="Back to Login" onAction="#onBackToLogin"
                    style="-fx-background-color: transparent; -fx-text-fill: #2e8b57; -fx-underline: true; -fx-cursor: hand; -fx-font-size: 12px; -fx-padding: 0;"/>
        </HBox>
    </VBox>
</VBox>
