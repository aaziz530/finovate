<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.esprit.finovate.controllers.ForumsController"
      spacing="0"
      style="-fx-background-color: transparent;">

    <!-- Header avec bouton Créer Forum -->
    <HBox spacing="15" alignment="CENTER_LEFT" 
          style="-fx-padding: 0 0 20 0;">
        <Label fx:id="titleLabel" text="Mes Forums" 
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1b;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="createForumBtn" text="+ Créer un Forum"
                onAction="#openCreateForumDialog" 
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 8 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

    <!-- Message si vide -->
    <Label fx:id="emptyLabel" text="Aucun forum disponible"
           style="-fx-font-size: 16px; -fx-text-fill: #7c7c7c; -fx-padding: 40 0;" 
           visible="false" managed="false"/>

    <!-- Liste des forums avec scroll -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;">
        <ListView fx:id="forumsList" 
                  style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-border-width: 0;"/>
    </ScrollPane>

</VBox>