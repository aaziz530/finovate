<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.esprit.finovate.controllers.AIPostGeneratorController"
            fitToWidth="true" style="-fx-background-color: #F8F9FA;">

    <VBox spacing="25" style="-fx-background-color: #F8F9FA; -fx-padding: 25;">

        <!-- Header -->
        <VBox spacing="5">
            <Label text="✨ Générateur de Post IA" 
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1A1A1B;"/>
            <Label text="Laissez l'IA créer des posts professionnels avec images pour vous" 
                   style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
        </VBox>

        <!-- Form -->
        <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3);">
            
            <!-- Theme -->
            <VBox spacing="8">
                <Label text="Thème du post" 
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                <TextField fx:id="themeField" promptText="Ex: Blockchain et Finance, NFT, DeFi..."
                           style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-border-width: 1;"/>
            </VBox>

            <!-- Forum Selection -->
            <VBox spacing="8">
                <Label text="📁 Forum de destination" 
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                <ComboBox fx:id="forumComboBox" maxWidth="Infinity"
                          promptText="Sélectionnez un forum..."
                          style="-fx-font-size: 14px;"/>
            </VBox>

            <!-- Tone and Length -->
            <HBox spacing="15">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Ton" 
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                    <ComboBox fx:id="toneComboBox" maxWidth="Infinity"
                              style="-fx-font-size: 14px;"/>
                </VBox>
                
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Longueur" 
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                    <ComboBox fx:id="lengthComboBox" maxWidth="Infinity"
                              style="-fx-font-size: 14px;"/>
                </VBox>
            </HBox>

            <!-- Generate Button -->
            <Button fx:id="generateButton" text="🎨 Générer Post + Image" onAction="#generatePost" maxWidth="Infinity"
                    style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 15; -fx-background-radius: 10; -fx-cursor: hand;"/>
            
            <!-- Status -->
            <Label fx:id="statusLabel" text="" 
                   style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
        </VBox>

        <!-- Preview -->
        <VBox fx:id="previewBox" spacing="20" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3);">
            
            <Label text="📋 Aperçu du Post" 
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A1A1B;"/>

            <!-- Image Preview -->
            <VBox spacing="10">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Image" 
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                    <Button fx:id="chooseImageButton" text="📁 Choisir une image" onAction="#chooseImage"
                            style="-fx-background-color: #0079D3; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 6 12; -fx-background-radius: 15; -fx-cursor: hand;"/>
                </HBox>
                <ImageView fx:id="previewImage" fitWidth="600" fitHeight="300" preserveRatio="true"
                           style="-fx-background-color: #F0F0F0; -fx-background-radius: 10;"/>
            </VBox>

            <!-- Title -->
            <VBox spacing="8">
                <Label text="Titre" 
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                <Label fx:id="titleLabel" text="" wrapText="true"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1A1A1B;"/>
            </VBox>

            <!-- Content -->
            <VBox spacing="8">
                <Label text="Contenu" 
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                <TextArea fx:id="contentArea" wrapText="true" prefRowCount="8" editable="true"
                          style="-fx-font-size: 14px; -fx-padding: 12; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-border-width: 1;"/>
            </VBox>

            <!-- Publish Button -->
            <Button fx:id="publishButton" text="✅ Publier le Post" onAction="#publishPost" maxWidth="Infinity"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 15; -fx-background-radius: 10; -fx-cursor: hand;"/>
        </VBox>

    </VBox>

</ScrollPane>
