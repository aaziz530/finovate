<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.esprit.finovate.controllers.AlertsController"
            styleClass="border-pane"
            stylesheets="@css/modern-style.css">

    <!-- Header -->
    <top>
        <VBox styleClass="header-section">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label fx:id="titleLabel" text="🔔 Mes Alertes" styleClass="app-title"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <Button fx:id="clearAllBtn" 
                        text="🗑️ Tout effacer" 
                        onAction="#clearAllAlerts"
                        styleClass="button-danger"
                        visible="false"
                        managed="false"/>
            </HBox>
        </VBox>
    </top>

    <!-- Contenu principal -->
    <center>
        <VBox styleClass="content-area" spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Message si vide -->
            <Label fx:id="emptyLabel" 
                   text="Aucune alerte pour le moment" 
                   styleClass="empty-label"
                   visible="true"
                   managed="true"
                   wrapText="true"
                   alignment="CENTER"
                   style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-padding: 40; -fx-text-alignment: center;"/>

            <!-- Liste des alertes -->
            <ListView fx:id="alertsList" 
                      styleClass="list-view"
                      style="-fx-background-color: transparent; -fx-border-color: transparent;"
                      VBox.vgrow="ALWAYS">
            </ListView>
        </VBox>
    </center>

</BorderPane>
