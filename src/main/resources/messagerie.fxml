<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.esprit.finovate.controllers.MessagingController"
            style="-fx-background-color: #f0f2f5;">

    <left>
        <VBox prefWidth="240"
              style="-fx-background-color: white;
                     -fx-border-color: #e2e8f0;
                     -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets top="16" right="8" bottom="16" left="8"/>
            </padding>

            <Label text="Mes Tickets"
                   style="-fx-font-size: 15px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2D3748;
                          -fx-padding: 0 0 8 4;"/>

            <TextField fx:id="searchField"
                       promptText="Rechercher par titre..."
                       style="-fx-background-radius: 8;
                              -fx-padding: 8 12;
                              -fx-font-size: 12px;
                              -fx-background-color: #f0f2f5;
                              -fx-border-color: transparent;"/>

            <ListView fx:id="ticketsList" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent;
                             -fx-border-color: transparent;
                             -fx-padding: 4 0 0 0;"/>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-background-color: #f7fafc;">

            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: white;
                         -fx-padding: 14 20;
                         -fx-border-color: #e2e8f0;
                         -fx-border-width: 0 0 1 0;">
                <Label fx:id="lblTicketTitle"
                       text="Selectionnez un ticket pour voir les messages"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2D3748;"/>
            </HBox>

            <ScrollPane fx:id="messagesScrollPane"
                        VBox.vgrow="ALWAYS"
                        fitToWidth="true"
                        style="-fx-background-color: transparent;
                               -fx-background: transparent;
                               -fx-border-color: transparent;
                               -fx-padding: 0;">
                <VBox fx:id="messagesContainer"
                      spacing="6"
                      style="-fx-padding: 16;
                             -fx-background-color: #f7fafc;
                             -fx-min-height: 400;"/>
            </ScrollPane>

            <HBox spacing="8" alignment="CENTER"
                  style="-fx-background-color: white;
                         -fx-padding: 12 16;
                         -fx-border-color: #e2e8f0;
                         -fx-border-width: 1 0 0 0;">
                <TextField fx:id="messageInput"
                           HBox.hgrow="ALWAYS"
                           promptText="Ecrire un message..."
                           style="-fx-background-radius: 20;
                                  -fx-padding: 10 16;
                                  -fx-font-size: 13px;
                                  -fx-background-color: #f0f2f5;
                                  -fx-border-color: transparent;"/>
                <Button fx:id="btnSend"
                        text="Envoyer"
                        onAction="#onSendMessage"
                        style="-fx-background-color: #2e8b57;
                               -fx-text-fill: white;
                               -fx-background-radius: 20;
                               -fx-padding: 10 20;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>