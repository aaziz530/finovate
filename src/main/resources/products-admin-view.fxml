<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="500.0" prefWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.esprit.finovate.controllers.ProductsAdminController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <VBox prefWidth="300.0" spacing="10.0" style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-background-radius: 10;">
        <Label text="Gestion Produits" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label text="Nom du produit" />
        <TextField fx:id="txtNom" promptText="Ex: iPhone 15" />

        <Label text="Description" />
        <TextField fx:id="txtDescription" promptText="Description du produit" />

        <Label text="Prix (points)" />
        <TextField fx:id="txtPrix" promptText="100" />

        <Label text="Chemin Image" />
        <HBox spacing="5">
            <TextField fx:id="txtImage" promptText="/images/product.png" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#choisirImage" text="Parcourir..." />
        </HBox>

        <Label text="Stock" />
        <TextField fx:id="txtStock" promptText="50" />

        <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 20 0 0 0;">
            <Button mnemonicParsing="false" onAction="#ajouter" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Ajouter" />
            <Button mnemonicParsing="false" onAction="#modifier" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="Modifier" />
            <Button mnemonicParsing="false" onAction="#supprimer" style="-fx-background-color: #c0392b; -fx-text-fill: white;" text="Supprimer" />
        </HBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS">
        <Label text="Liste des produits disponibles" />
        <TextField fx:id="txtRechercheProducts" promptText="Rechercher un produit..." />
        <TableView fx:id="tableProducts" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNom" prefWidth="120.0" text="Nom" />
                <TableColumn fx:id="colDescription" prefWidth="150.0" text="Description" />
                <TableColumn fx:id="colPrix" prefWidth="80.0" text="Prix (pts)" />
                <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</HBox>
