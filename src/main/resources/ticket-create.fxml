<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.esprit.finovate.controllers.TicketCreateController"
      spacing="12.0"
      style="-fx-background-color: transparent;">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Créer un ticket"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

    <VBox spacing="8.0"
          style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 8, 0.3, 0, 3);">

        <Label text="Titre" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
        <TextField fx:id="titreField" promptText="Sujet de la réclamation"/>

        <Label text="Description" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
        <TextArea fx:id="descriptionArea" promptText="Décrivez le problème..." prefRowCount="4"/>

        <Label text="Catégorie" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
        <ComboBox fx:id="categorieCombo" promptText="Choisir une catégorie"/>

        <Label text="Priorité" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
        <ComboBox fx:id="prioriteCombo" promptText="Low / Medium / High"/>

        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <Button text="Joindre un fichier" onAction="#onAttachFile"
                    style="-fx-background-color: #e5e7eb; -fx-text-fill: #111827;"/>
            <Label fx:id="attachedFileLabel" text="Aucun fichier sélectionné"
                   style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
        </HBox>

        <HBox spacing="8.0" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
            <Button text="Annuler" onAction="#onCancel"
                    style="-fx-background-color: #e5e7eb; -fx-text-fill: #111827;"/>
            <Button text="Créer le ticket" onAction="#onSubmit"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>

</VBox>

